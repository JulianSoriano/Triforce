// Golden Sun password core — mirrors the spreadsheet's Calculation sheet exactly.
// state: { mode:'base'|'stats', levels[4], djinn:Set(names), events:{hammet,colosso,hsu,deadbeard,vale,vault},
//          stats[4][6] (HP,PP,ATK,DEF,AGI,LCK), items[4][15] of {name, qty} or null, coins }
function makeCore(D) {
  const MULT = [ // Squire, Guard, Wind Seer, Water Seer — HP,PP,ATK,DEF,AGI,LCK
    [1.1, 0.8, 1.1, 1.0, 1.1, 1.0],
    [1.1, 0.8, 1.0, 1.1, 0.7, 1.0],
    [0.8, 1.4, 0.8, 0.9, 1.3, 1.1],
    [0.9, 1.3, 0.9, 1.0, 0.8, 1.3],
  ];
  const STAT_BITS = [11, 11, 10, 10, 10, 8];
  const STAT_MAX = [1999, 1999, 999, 999, 999, 99];
  const idOf = new Map();
  D.items.forEach((n, i) => { if (n !== '?' && !idOf.has(n)) idOf.set(n, i + 1); });
  const stackSet = new Set(D.stack);
  const bin = (v, n) => { v = Math.floor(v); let s = v.toString(2); return s.length > n ? s : '0'.repeat(n - s.length) + s; };

  function hiddenStat(state, c, s) {
    const v = Number(state.stats[c][s]) || 0;
    return state.mode === 'stats' ? Math.floor((v + 0.9) / MULT[c][s]) : v;
  }

  function validate(state) {
    const errs = [];
    state.levels.forEach((l, c) => { if (!(l >= 0 && l <= 99 && Number.isInteger(+l))) errs.push({ where: `level-${c}`, msg: 'Level must be 0–99' }); });
    for (let c = 0; c < 4; c++) for (let s = 0; s < 6; s++) {
      const raw = Number(state.stats[c][s]);
      const h = hiddenStat(state, c, s);
      if (!(raw >= 0) || h > STAT_MAX[s] || !Number.isFinite(raw)) errs.push({ where: `stat-${c}-${s}`, msg: `Too high (stored value ${h} > ${STAT_MAX[s]})` });
    }
    for (let c = 0; c < 4; c++) state.items[c].forEach((it, k) => {
      if (!it) return;
      if (!idOf.has(it.name)) errs.push({ where: `item-${c}-${k}`, msg: 'Unknown item' });
      else if (it.qty > 1 && !stackSet.has(it.name)) errs.push({ where: `item-${c}-${k}`, msg: 'This item can’t be stacked in a password' });
      else if (it.qty > 30) errs.push({ where: `item-${c}-${k}`, msg: 'Max stack is 30' });
    });
    if (!(state.coins >= 0 && state.coins <= 999999)) errs.push({ where: 'coins', msg: 'Coins must be 0–999,999' });
    return errs;
  }

  function buildBits(state) {
    // Levels: mia & ivan & garet & isaac, then rearranged [21:28][13:20][5:12][1:4]
    const L = [3, 2, 1, 0].map(c => bin(state.levels[c], 7)).join('');
    const levelbits = L.slice(20, 28) + L.slice(12, 20) + L.slice(4, 12) + L.slice(0, 4);
    // Djinn: per element, djinn 7..1; jupiter & mars & mercury & venus, then [25:28][17:24][9:16][1:8]
    const el = e => { let s = ''; for (let r = 7; r >= 1; r--) s += state.djinn.has(D.djinn[e * 7 + r - 1]) ? '1' : '0'; return s; };
    const Dj = el(3) + el(2) + el(1) + el(0);
    const djinnbits = Dj.slice(24, 28) + Dj.slice(16, 24) + Dj.slice(8, 16) + Dj.slice(0, 8);
    const ev = state.events;
    const eventbits = '00' + [ev.vault, ev.vale, ev.deadbeard, !ev.hsu, ev.colosso, ev.hammet].map(b => b ? '1' : '0').join('');
    const owned = new Set(); state.items.forEach(list => list.forEach(it => it && owned.add(it.name)));
    let psy = ''; for (let i = 7; i >= 0; i--) psy += owned.has(D.psy[i]) ? '1' : '0';
    let stats = '';
    for (let c = 0; c < 4; c++) for (let s = 0; s < 6; s++) stats += bin(hiddenStat(state, c, s), STAT_BITS[s]);
    let ids = '';
    for (let c = 0; c < 4; c++) for (let k = 0; k < 15; k++) { const it = state.items[c][k]; ids += bin(it ? idOf.get(it.name) : 0, 9); }
    const chunks = []; for (let i = 0; i < ids.length; i += 63) chunks.push(ids.slice(i, i + 63));
    const itemIds = chunks.join('0');
    let qty = '';
    for (let c = 0; c < 4; c++) for (const sn of D.stack) {
      const it = state.items[c].find(x => x && x.name === sn);
      qty += bin(it ? Math.max(0, (it.qty || 1) - 1) : 0, 5);
    }
    const coins = bin(state.coins, 24);
    return {
      gold: levelbits + djinnbits + eventbits + stats + '0'.repeat(8) + itemIds + qty + coins + '0'.repeat(40),
      silver: levelbits + djinnbits + eventbits + psy + stats,
      bronze: levelbits + djinnbits + eventbits + psy,
    };
  }

  function encode(bits) {
    const bytes = []; for (let i = 0; i < bits.length; i += 8) bytes.push(parseInt(bits.slice(i, i + 8), 2));
    let key = 0xFFFF;
    for (const b of bytes) {
      key = (b * 256) ^ key;
      for (let i = 0; i < 8; i++) key = (2 * key + (key >= 0x8000 ? 0xEFDF : 0)) % 65536;
    }
    const inv = (-key - 1 + 65536) % 65536, hi = inv >> 8, lo = inv & 255;
    const out = bytes.map(b => b ^ lo); out.push(hi ^ lo); out.push(lo);
    let s = out.map(b => bin(b, 8)).join('');
    s += '0'.repeat((6 - s.length % 6) % 6);
    const dataGroups = []; for (let i = 0; i < s.length; i += 6) dataGroups.push(parseInt(s.slice(i, i + 6), 2));
    const groups = []; let di = 0;
    while (di < dataGroups.length) {
      const blk = dataGroups.slice(di, di + 9); di += 9;
      groups.push(...blk);
      if (blk.length === 9) groups.push(blk.reduce((a, b) => a + b, 0) % 64);
    }
    return groups.map((g, n) => D.chars[(g + n) % 64]).join('');
  }

  function generate(state) {
    const bits = buildBits(state);
    return { gold: encode(bits.gold), silver: encode(bits.silver), bronze: encode(bits.bronze), bits };
  }
  return { generate, validate, hiddenStat, idOf, stackSet, MULT, STAT_MAX };
}


