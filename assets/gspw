const EVENTS = [
  { key: 'hammet', label: 'Saved Hammet' }, { key: 'colosso', label: 'Won Colosso' }, { key: 'hsu', label: 'Saved Hsu' },
  { key: 'deadbeard', label: 'Beat Deadbeard' }, { key: 'vale', label: 'Returned to Vale' }, { key: 'vault', label: 'Returned to Vault' },
];
const TIERS = {
  gold: '<b>Gold</b> carries levels, stats, Djinn, story events, every item and quantity, and coins.',
  silver: '<b>Silver</b> carries levels, stats, Djinn, story events and Psynergy items. Other items and coins are dropped.',
  bronze: '<b>Bronze</b> carries levels, Djinn, story events and Psynergy items. Stats, items and coins are dropped.',
};
const ITEM_NAMES = [...core.idOf.keys()];
const nameByLower = new Map(ITEM_NAMES.map(n => [n.toLowerCase(), n]));

function blankState() {
  return { mode: 'base', levels: [1, 1, 1, 1], djinn: new Set(),
    events: { hammet: false, colosso: false, hsu: false, deadbeard: false, vale: false, vault: false },
    stats: HEROES.map(() => [0, 0, 0, 0, 0, 0]), items: HEROES.map(() => Array(15).fill(null)), coins: 0 };
}
function exampleState() {
  const s = blankState();
  const lists = [
    ["Sol Blade","Warrior's Helm","Dragon Scales","Spirit Gloves","Catch Beads","Carry Stone","Black Orb","Running Shirt","Mythril Shirt","Soul Ring","Ninja Sandals","Ninja Sandals","Ninja Sandals","Ninja Sandals","Orihalcon"],
    ["Excalibur","Warrior's Helm","Asura's Armor","War Gloves","Cleric's Ring","Lifting Gem","Mars Star","Hyper Boots","Quick Boots","Silver Greave","Knight's Greave","Silver Greave","Silver Greave","Knight's Greave","Orihalcon"],
    ["Kikuichimonji","Mythril Circlet","Feathered Robe","Spirit Armlet","Cloak Ball","Orb of Force","Halt Gem","Mythril Shirt","Hyper Boots","Casual Shirt","Rainbow Ring","Herbed Shirt","Lucky Pepper","Orihalcon","Orihalcon"],
    ["Zodiac Wand","Lucky Cap","Oracle's Robe","Virtuous Armlet","Douse Drop","Frost Jewel","Swift Sword","Silk Shirt","Quick Boots","Divine Camisole","Soul Ring","Aroma Ring","Mysterious Robe","Divine Camisole","Swift Sword"],
  ];
  s.levels = [99, 99, 99, 99]; s.djinn = new Set(D.djinn);
  Object.keys(s.events).forEach(k => s.events[k] = true);
  s.stats = HEROES.map(() => [1999, 1999, 999, 999, 999, 99]);
  s.items = lists.map(l => l.map(n => ({ name: n, qty: 1 })));
  s.coins = 999999;
  return s;
}

let state = exampleState();
let ui = { tier: 'gold', itemTab: 0 };
const $ = id => document.getElementById(id);
const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

// ---------- persistence ----------
const KEY = 'gs-pw-gen-v1';
function save() {
  try { localStorage.setItem(KEY, JSON.stringify({ ...state, djinn: [...state.djinn], ui })); } catch (e) {}
}
function load() {
  try {
    const raw = localStorage.getItem(KEY); if (!raw) return;
    const o = JSON.parse(raw);
    if (!o || !Array.isArray(o.levels) || !Array.isArray(o.items)) return;
    state = { ...blankState(), ...o, djinn: new Set(o.djinn || []) };
    if (o.ui) ui = { ...ui, ...o.ui };
  } catch (e) {}
}

// ---------- build static UI ----------
function buildParty() {
  $('party').innerHTML = HEROES.map((h, c) => `
    <div class="hero el-${h.el}">
      <div class="nm"><h3>${h.name}</h3><span class="cls">${h.cls}</span></div>
      <div class="statrow lvl"><label for="lv-${c}">LV</label><input class="num" id="lv-${c}" type="number" min="0" max="99" inputmode="numeric"></div>
      ${STATS.map((s, i) => `<div class="statrow"><label for="st-${c}-${i}">${s}</label><input class="num" id="st-${c}-${i}" type="number" min="0" inputmode="numeric"></div><div class="stored" id="sd-${c}-${i}" hidden></div>`).join('')}
    </div>`).join('');
  HEROES.forEach((h, c) => {
    $('lv-' + c).addEventListener('input', e => { state.levels[c] = e.target.value === '' ? 0 : +e.target.value; refresh(); });
    STATS.forEach((s, i) => $(`st-${c}-${i}`).addEventListener('input', e => { state.stats[c][i] = e.target.value === '' ? 0 : +e.target.value; refresh(); }));
  });
  document.querySelectorAll('input[name="mode"]').forEach(r => r.addEventListener('change', e => { state.mode = e.target.value; refresh(); }));
}
function buildDjinn() {
  $('djinn').innerHTML = ELEMENTS.map((e, ei) => `
    <div class="el-col el-${e.el}">
      <header><h3>${e.name} <span class="count" id="djc-${ei}"></span></h3><button class="linkbtn" data-el="${ei}" type="button" id="djall-${ei}">All</button></header>
      ${D.djinn.slice(ei * 7, ei * 7 + 7).map((n, k) => `<label class="dj"><input type="checkbox" id="dj-${ei * 7 + k}" data-name="${esc(n)}">${esc(n)}</label>`).join('')}
    </div>`).join('');
  D.djinn.forEach((n, i) => $('dj-' + i).addEventListener('change', e => { e.target.checked ? state.djinn.add(n) : state.djinn.delete(n); refresh(); }));
  ELEMENTS.forEach((e, ei) => $('djall-' + ei).addEventListener('click', () => {
    const names = D.djinn.slice(ei * 7, ei * 7 + 7); const all = names.every(n => state.djinn.has(n));
    names.forEach(n => all ? state.djinn.delete(n) : state.djinn.add(n)); syncInputs(); refresh();
  }));
}
function buildItems() {
  const dl = document.createElement('datalist'); dl.id = 'item-list';
  dl.innerHTML = ITEM_NAMES.map(n => `<option value="${esc(n)}"></option>`).join('');
  document.body.appendChild(dl);
  $('item-tabs').innerHTML = HEROES.map((h, c) => `<button class="tab el-${h.el}" role="tab" type="button" id="itab-${c}" data-c="${c}"><span class="dot"></span>${h.name}<span class="badge" id="ibadge-${c}"></span></button>`).join('');
  HEROES.forEach((h, c) => $('itab-' + c).addEventListener('click', () => { ui.itemTab = c; renderSlots(); save(); }));
  $('psy').innerHTML = D.psy.map((n, i) => `<span class="chip" id="psy-${i}">${esc(n)}</span>`).join(' ');
}
function renderSlots() {
  const c = ui.itemTab;
  HEROES.forEach((h, i) => $('itab-' + i).setAttribute('aria-selected', i === c ? 'true' : 'false'));
  $('slots').setAttribute('aria-labelledby', 'itab-' + c);
  $('slots').innerHTML = Array.from({ length: 15 }, (_, k) => `
    <div class="slot">
      <span class="n">${k + 1}</span>
      <input class="item-in" id="it-${k}" list="item-list" autocomplete="off" spellcheck="false" placeholder="Empty" aria-label="${HEROES[c].name} item ${k + 1}">
      <input class="num qty" id="iq-${k}" type="number" min="1" max="30" inputmode="numeric" aria-label="Quantity for item ${k + 1}" title="Quantity">
      <span class="err" id="ie-${k}" hidden></span>
    </div>`).join('');
  for (let k = 0; k < 15; k++) {
    const it = state.items[c][k];
    $('it-' + k).value = it ? it.name : '';
    $('iq-' + k).value = it ? (it.qty || 1) : '';
    $('it-' + k).addEventListener('input', e => {
      const raw = e.target.value.trim();
      if (!raw) { state.items[c][k] = null; }
      else {
        let name = nameByLower.get(raw.toLowerCase()) || raw;
        if (/^\d+$/.test(raw)) { const byId = D.items[+raw - 1]; if (byId && byId !== '?') name = byId; }
        const prev = state.items[c][k];
        state.items[c][k] = { name, qty: prev ? prev.qty : 1 };
      }
      refresh();
    });
    $('it-' + k).addEventListener('change', e => { const it = state.items[c][k]; if (it && core.idOf.has(it.name)) e.target.value = it.name; });
    $('iq-' + k).addEventListener('input', e => { const it = state.items[c][k]; if (it) { it.qty = Math.max(1, +e.target.value || 1); refresh(); } });
  }
  refresh();
}
function buildEvents() {
  $('events').innerHTML = EVENTS.map(ev => `<label class="ev"><input type="checkbox" id="ev-${ev.key}">${ev.label}</label>`).join('');
  EVENTS.forEach(ev => $('ev-' + ev.key).addEventListener('change', e => { state.events[ev.key] = e.target.checked; refresh(); }));
  $('coins').addEventListener('input', e => { state.coins = e.target.value === '' ? 0 : +e.target.value; refresh(); });
}
function buildTablet() {
  document.querySelectorAll('.ttab').forEach(b => b.addEventListener('click', () => { ui.tier = b.dataset.tier; refresh(); }));
  $('btn-copy').addEventListener('click', () => copy(current[ui.tier], 'Password copied'));
  $('btn-copy-rows').addEventListener('click', () => copy(rows(current[ui.tier]).join('\n'), 'Copied in rows of 10'));
  $('btn-example').addEventListener('click', () => { state = exampleState(); syncInputs(); renderSlots(); toast('Loaded the max-everything example'); });
  $('btn-clear').addEventListener('click', () => { state = blankState(); syncInputs(); renderSlots(); toast('Cleared. Every field is back to empty.'); });
}

// ---------- sync + render ----------
function syncInputs() {
  $('mode-' + state.mode).checked = true;
  HEROES.forEach((h, c) => { $('lv-' + c).value = state.levels[c]; STATS.forEach((s, i) => $(`st-${c}-${i}`).value = state.stats[c][i]); });
  D.djinn.forEach((n, i) => $('dj-' + i).checked = state.djinn.has(n));
  EVENTS.forEach(ev => $('ev-' + ev.key).checked = !!state.events[ev.key]);
  $('coins').value = state.coins;
}
let current = { gold: '', silver: '', bronze: '' };
const rows = pw => { const r = []; for (let i = 0; i < pw.length; i += 10) r.push(pw.slice(i, i + 5) + (pw.length > i + 5 ? ' ' + pw.slice(i + 5, i + 10) : '')); return r; };

function refresh() {
  // mode hint + stored values
  $('mode-hint').textContent = state.mode === 'stats'
    ? 'Enter the stats shown in-game with no equipment on and every Djinn on Standby. Each is divided by the default class multiplier to get the stored value.'
    : 'Enter hidden base stats directly: no Djinn, equipment or class multipliers applied.';
  for (let c = 0; c < 4; c++) for (let i = 0; i < 6; i++) {
    const el = $(`sd-${c}-${i}`);
    if (state.mode === 'stats') { el.hidden = false; el.textContent = 'stored ' + core.hiddenStat(state, c, i); } else el.hidden = true;
  }
  // djinn counts
  ELEMENTS.forEach((e, ei) => {
    const n = D.djinn.slice(ei * 7, ei * 7 + 7).filter(d => state.djinn.has(d)).length;
    $('djc-' + ei).textContent = n + '/7';
    $('djall-' + ei).textContent = n === 7 ? 'None' : 'All';
  });
  $('dj-total').textContent = state.djinn.size + ' / 28';
  // items: badges, qty enable, psy chips
  HEROES.forEach((h, c) => $('ibadge-' + c).textContent = state.items[c].filter(Boolean).length + '/15');
  const c = ui.itemTab;
  for (let k = 0; k < 15; k++) {
    const it = state.items[c][k], q = $('iq-' + k);
    if (!q) continue;
    const stackable = it && core.stackSet.has(it.name);
    q.disabled = !stackable;
    if (!stackable && document.activeElement !== q) q.value = it ? 1 : '';
  }
  const owned = new Set(); state.items.forEach(l => l.forEach(it => it && owned.add(it.name)));
  D.psy.forEach((n, i) => $('psy-' + i).classList.toggle('on', owned.has(n)));

  // validation
  document.querySelectorAll('.bad').forEach(e => e.classList.remove('bad'));
  document.querySelectorAll('.slot .err').forEach(e => e.hidden = true);
  const errs = core.validate(state);
  const tierErrs = errs.filter(e => ui.tier === 'gold' || !(e.where.startsWith('item') || e.where === 'coins') && !(ui.tier === 'bronze' && e.where.startsWith('stat')));
  for (const e of errs) {
    const [kind, a, b] = e.where.split('-');
    if (kind === 'level') $('lv-' + a).classList.add('bad');
    else if (kind === 'stat') { $(`st-${a}-${b}`).classList.add('bad'); }
    else if (kind === 'coins') $('coins').classList.add('bad');
    else if (kind === 'item' && +a === c) { $('it-' + b).classList.add('bad'); const m = $('ie-' + b); m.hidden = false; m.textContent = e.msg; }
  }
  const iss = $('issues');
  if (tierErrs.length) {
    iss.hidden = false;
    const where = w => { const [k, a, b] = w.split('-'); return k === 'level' ? HEROES[a].name + ' level' : k === 'stat' ? HEROES[a].name + ' ' + STATS[b] : k === 'coins' ? 'Coins' : HEROES[a].name + ' item ' + (+b + 1); };
    iss.innerHTML = `<b>${tierErrs.length} field${tierErrs.length > 1 ? 's need' : ' needs'} fixing before this password will work.</b>` +
      tierErrs.slice(0, 4).map(e => `<span>${esc(where(e.where))}: ${esc(e.msg)}</span>`).join('') + (tierErrs.length > 4 ? `<span>…and ${tierErrs.length - 4} more, marked in red.</span>` : '');
  } else iss.hidden = true;
  $('tablet').classList.toggle('stale', tierErrs.length > 0);

  // generate
  try { current = core.generate(state); } catch (e) { current = { gold: '', silver: '', bronze: '' }; }
  document.querySelectorAll('.ttab').forEach(b => b.setAttribute('aria-selected', b.dataset.tier === ui.tier ? 'true' : 'false'));
  $('includes').innerHTML = TIERS[ui.tier];
  const pw = current[ui.tier] || '';
  $('pw-len').textContent = pw.length + ' symbols · ' + Math.ceil(pw.length / 10) + ' rows';
  $('pw').innerHTML = rows(pw).map((r, i) => {
    const [a, b] = r.split(' ');
    const g = s => s ? `<span class="grp">${[...s].map(ch => `<span>${esc(ch)}</span>`).join('')}</span>` : '<span></span>';
    return `<div class="pw-row"><span class="ln">${i + 1}</span>${g(a)}${g(b)}</div>`;
  }).join('');
  save();
}

let toastTimer;
function toast(msg) { $('toast').textContent = msg; clearTimeout(toastTimer); toastTimer = setTimeout(() => $('toast').textContent = '', 2600); }
function copy(text, msg) {
  const ta = $('copytext');
  const fallback = () => { ta.hidden = false; ta.value = text; ta.focus(); ta.select(); toast('Press Ctrl+C (or ⌘C) to copy the selected text'); };
  try {
    navigator.clipboard.writeText(text).then(() => { ta.hidden = true; toast(msg); }, fallback);
  } catch (e) { fallback(); }
}

load();
buildParty(); buildDjinn(); buildItems(); buildEvents(); buildTablet();
syncInputs(); renderSlots();
</script>

</body>
</html>
