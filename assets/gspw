        <div class="issues" id="issues" hidden></div>
        <div class="pw-scroll"><div class="pw" id="pw" aria-live="polite"></div></div>
        <div class="tbar">
          <div style="display:flex;gap:8px;flex-wrap:wrap">
            <button class="tbtn" id="btn-copy" type="button">Copy password</button>
            <button class="tbtn alt" id="btn-copy-rows" type="button">Copy as rows</button>
          </div>
        </div>
        <textarea class="copytext" id="copytext" rows="3" readonly hidden aria-label="Password text to copy"></textarea>
        <div class="toast" id="toast" role="status"></div>
      </div>
    </aside>
  </div>
</div>

