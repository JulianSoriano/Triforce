/* Layout: two-pane workbench — party editor on the left, a sticky "password tablet" on the right; stacks with the tablet first on phones. */
:root {
  --bg: #eef0f4;
  --surface: #ffffff;
  --sunk: #e3e6ee;
  --line: #cfd4e0;
  --fg: #1d2333;
  --muted: #5b6377;
  --accent: #a8770f;          /* alchemy gold */
  --accent-ink: #ffffff;
  --accent-soft: #f6ead0;
  --venus: #9a6a1c; --venus-soft: #f3e6cc;
  --mercury: #1f6fa6; --mercury-soft: #d8e9f5;
  --mars: #b23a2e; --mars-soft: #f6dcd8;
  --jupiter: #6c4fa8; --jupiter-soft: #e7e0f4;
  --gold: #b88a12; --silver: #7d8696; --bronze: #a35f2c;
  --bad: #c0392b; --bad-soft: #fbe3e0;
  --ok: #2d7a4f;
  --tablet: #232a3d; --tablet-fg: #f3e7c4; --tablet-dim: #8f93a6; --tablet-cell: #2e3650;
  --f-display: "Marcellus SC", "Trajan Pro", Georgia, serif;
  --f-body: "Figtree", system-ui, -apple-system, "Segoe UI", sans-serif;
  --f-mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  --r: 10px;
}
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
  --bg: #12151f; --surface: #1a1f2d; --sunk: #222838; --line: #313950; --fg: #e7e9f0; --muted: #9aa1b5;
  --accent: #e0ad3e; --accent-ink: #1b1607; --accent-soft: #3a3020;
  --venus: #e0b061; --venus-soft: #3a2f1e; --mercury: #6db3e3; --mercury-soft: #1b3043;
  --mars: #ec7d6f; --mars-soft: #42231f; --jupiter: #b59ae6; --jupiter-soft: #2f2645;
  --gold: #e3b53f; --silver: #b4bccb; --bronze: #d58b55;
  --bad: #ff8a7a; --bad-soft: #43201d; --ok: #6fcf97;
  --tablet: #0b0e16; --tablet-fg: #f5df9f; --tablet-dim: #7a7f93; --tablet-cell: #181d2b;
  color-scheme: dark } }
:root[data-theme="dark"] {
  --bg: #12151f; --surface: #1a1f2d; --sunk: #222838; --line: #313950; --fg: #e7e9f0; --muted: #9aa1b5;
  --accent: #e0ad3e; --accent-ink: #1b1607; --accent-soft: #3a3020;
  --venus: #e0b061; --venus-soft: #3a2f1e; --mercury: #6db3e3; --mercury-soft: #1b3043;
  --mars: #ec7d6f; --mars-soft: #42231f; --jupiter: #b59ae6; --jupiter-soft: #2f2645;
  --gold: #e3b53f; --silver: #b4bccb; --bronze: #d58b55;
  --bad: #ff8a7a; --bad-soft: #43201d; --ok: #6fcf97;
  --tablet: #0b0e16; --tablet-fg: #f5df9f; --tablet-dim: #7a7f93; --tablet-cell: #181d2b;
  color-scheme: dark }

/* Fantasy skin (default): Golden Sun menu windows — night-blue gradient panes framed in parchment and gold, set on a starlit sky. Single dark world on purpose. */
:root[data-skin="fantasy"] {
  --bg: #0b1130; --surface: #15225a; --sunk: #0e1842; --line: #40549c; --fg: #f3ecd6; --muted: #aab4da;
  --accent: #eac35c; --accent-ink: #1d1405; --accent-soft: #3d3418;
  --venus: #ecbd66; --venus-soft: #3c3120; --mercury: #74c6f2; --mercury-soft: #173763;
  --mars: #ff8f74; --mars-soft: #4b2129; --jupiter: #c9a8ff; --jupiter-soft: #32285f;
  --gold: #f2cb4e; --silver: #ccd4e8; --bronze: #e39d60;
  --bad: #ff9484; --bad-soft: #4e1f2b; --ok: #82e3a9;
  --tablet: #0a0e22; --tablet-fg: #f6d97c; --tablet-dim: #8d94ba; --tablet-cell: #19214d;
  --frame: #eadcb0; --frame-gold: #b8913a; --win-top: #27468f; --win-bot: #13235e; --field: #0a1336;
  --f-display: "Cinzel", "Trajan Pro", Georgia, serif;
  --f-body: "Alegreya Sans", "Figtree", system-ui, sans-serif;
  color-scheme: dark;
}
:root[data-skin="fantasy"] body {
  background-color: var(--bg);
  background-image:
    radial-gradient(1.2px 1.2px at 23px 41px, #fff8 50%, transparent 51%),
    radial-gradient(1px 1px at 131px 87px, #fff6 50%, transparent 51%),
    radial-gradient(1.4px 1.4px at 187px 19px, #ffe9a8aa 50%, transparent 51%),
    radial-gradient(1px 1px at 71px 163px, #fff5 50%, transparent 51%),
    radial-gradient(1px 1px at 211px 191px, #fff4 50%, transparent 51%),
    radial-gradient(ellipse 70% 45% at 15% -5%, #2d3f8fcc, transparent 70%),
    radial-gradient(ellipse 60% 40% at 95% 5%, #40297099, transparent 70%);
  background-size: 230px 230px, 230px 230px, 230px 230px, 230px 230px, 230px 230px, 100% 900px, 100% 900px;
  background-repeat: repeat, repeat, repeat, repeat, repeat, no-repeat, no-repeat;
  font-size: 16px;
}
:root[data-skin="fantasy"] h1 { font-family: "Cinzel Decorative", var(--f-display); font-weight: 700; color: var(--gold);
  background: linear-gradient(180deg, #fff1bf 0%, #f2cb4e 45%, #b8862a 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 2px 0 #00000080); }
:root[data-skin="fantasy"] h2 { font-weight: 700; color: var(--frame); letter-spacing: .04em; }
:root[data-skin="fantasy"] h2::before { content: "\25C6"; color: var(--accent); font-size: .6em; margin-right: .5em; vertical-align: .2em; }
:root[data-skin="fantasy"] h3 { font-weight: 700; }
:root[data-skin="fantasy"] .section,
:root[data-skin="fantasy"] details.how {
  background: linear-gradient(180deg, var(--win-top) 0%, var(--win-bot) 100%);
  border: 2px solid var(--frame); border-radius: 9px;
  box-shadow: inset 0 0 0 2px #081236, inset 0 0 0 3px var(--frame-gold), 0 14px 30px -16px #000;
}
:root[data-skin="fantasy"] .hero { background: linear-gradient(var(--el-soft), #0c1747cc 90px); border-color: #4a5fa8; }
:root[data-skin="fantasy"] .num, :root[data-skin="fantasy"] .item-in { background: var(--field); border-color: #4a5ea8; }
:root[data-skin="fantasy"] .num.bad, :root[data-skin="fantasy"] .item-in.bad { background: var(--bad-soft); border-color: var(--bad); }
:root[data-skin="fantasy"] .btn { background: linear-gradient(180deg, var(--win-top), var(--win-bot)); border: 1px solid var(--frame); color: var(--frame); font-family: var(--f-display); letter-spacing: .03em; }
:root[data-skin="fantasy"] .btn:hover { border-color: var(--accent); color: var(--accent); }
:root[data-skin="fantasy"] .tab, :root[data-skin="fantasy"] .dj, :root[data-skin="fantasy"] .ev { background: #0d1a4ccc; border-color: #42569e; }
:root[data-skin="fantasy"] .tab[aria-selected="true"] { background: var(--el-soft); border-color: var(--el); }
:root[data-skin="fantasy"] .dj:has(input:checked) { background: var(--el-soft); border-color: var(--el); }
:root[data-skin="fantasy"] .ev:has(input:checked) { background: var(--accent-soft); border-color: var(--accent); }
:root[data-skin="fantasy"] .mode { background: var(--field); border: 1px solid #42569e; }
:root[data-skin="fantasy"] .mode label:has(input:checked) { background: linear-gradient(180deg, var(--win-top), var(--win-bot)); box-shadow: inset 0 0 0 1px var(--frame-gold); }
:root[data-skin="fantasy"] .tablet {
  background: radial-gradient(ellipse at 50% 0%, #1d2550 0%, var(--tablet) 70%);
  border: 2px solid var(--frame-gold); border-radius: 12px;
  box-shadow: inset 0 0 0 4px var(--tablet), inset 0 0 0 5px #b8913a88, 0 18px 40px -18px #000, 0 0 40px -10px #eac35c33;
}
:root[data-skin="fantasy"] .tablet h2::before { color: var(--tablet-fg); }
:root[data-skin="fantasy"] .grp span { border: 1px solid #b8913a40; text-shadow: 0 0 6px #f6d97c55; }
:root[data-skin="fantasy"] .ttab { font-weight: 700; }
:root[data-skin="fantasy"] .tbtn { font-family: var(--f-display); font-weight: 700; background: linear-gradient(180deg, #fbe7a4, #d9a93c); }
:root[data-skin="fantasy"] .tbtn.alt { background: transparent; }
:root[data-skin="fantasy"] details.how summary { font-weight: 700; color: var(--frame); }
:root[data-skin="fantasy"] details.how code { background: var(--field); }
:root[data-skin="fantasy"] .lede { color: var(--muted); }
:root[data-skin="fantasy"] .elements span { box-shadow: 0 0 10px var(--c, transparent); }

/* Triforce skin: the same quiet dark look as the rest of Triforce (near-black neutrals, hairline borders, Geist type), in the Golden Sun purple. */
:root[data-skin="triforce"] {
  --bg: #0a0b0f; --surface: #13151b; --sunk: #1a1d25; --line: #252935; --fg: #eceef4; --muted: #9299ab;
  --accent: #C9A8F0; --accent-ink: #0a0b0f; --accent-soft: #271A3A;
  --venus: #E8B86A; --venus-soft: #2c2314; --mercury: #7FBCE6; --mercury-soft: #16303F;
  --mars: #F2837A; --mars-soft: #3A1C1E; --jupiter: #C9A8F0; --jupiter-soft: #271A3A;
  --gold: #f2c14e; --silver: #B4C0CE; --bronze: #EBA57A;
  --bad: #ff8a7a; --bad-soft: #3a1d1b; --ok: #79C79C;
  --tablet: #13151b; --tablet-fg: #eceef4; --tablet-dim: #9299ab; --tablet-cell: #1a1d25;
  --f-display: "Geist", system-ui, -apple-system, "Segoe UI", sans-serif;
  --f-body: "Geist", system-ui, -apple-system, "Segoe UI", sans-serif;
