  color-scheme: dark;
}
:root[data-skin="triforce"] body { font-size: 15px; }
:root[data-skin="triforce"] .wrap { padding-block: 18px 40px; padding-inline: 18px; max-width: none; }
:root[data-skin="triforce"] h1 { font-weight: 400; font-size: clamp(24px, 4vw, 34px); letter-spacing: .02em; }
:root[data-skin="triforce"] h2, :root[data-skin="triforce"] h3 { font-weight: 600; letter-spacing: 0; }
:root[data-skin="triforce"] .btn { font-weight: 600; background: var(--surface); }
:root[data-skin="triforce"] .btn:hover { border-color: var(--accent); }
:root[data-skin="triforce"] .btn.ghost { background: transparent; }
:root[data-skin="triforce"] .section, :root[data-skin="triforce"] details.how { border-radius: 10px; }
:root[data-skin="triforce"] .hero { background: var(--surface); border-top-width: 3px; }
:root[data-skin="triforce"] .tab { background: var(--surface); }
:root[data-skin="triforce"] .tab[aria-selected="true"], :root[data-skin="triforce"] .dj:has(input:checked) { background: var(--el-soft); border-color: var(--el); }
:root[data-skin="triforce"] .mode { background: var(--ground, #0a0b0f); border: 1px solid var(--line); }
:root[data-skin="triforce"] .mode label:has(input:checked) { background: var(--sunk); box-shadow: none; }
:root[data-skin="triforce"] .tablet { background: var(--surface); border: 1px solid var(--line); box-shadow: none; }
:root[data-skin="triforce"] .ttab { font-weight: 600; border-color: var(--line); }
:root[data-skin="triforce"] .ttab[aria-selected="true"] { color: #0a0b0f; }
:root[data-skin="triforce"] .tbtn { background: var(--accent); color: var(--accent-ink); font-weight: 600; }
:root[data-skin="triforce"] .tbtn.alt { background: transparent; color: var(--fg); border: 1px solid var(--line); }
:root[data-skin="triforce"] .grp span { border: 1px solid var(--line); }
:root[data-skin="triforce"] .copytext { border-color: var(--line); color: var(--fg); }
:root[data-skin="triforce"] .elements span { box-shadow: none; }
:root[data-skin="triforce"] footer.credit a, :root[data-skin="triforce"] .linkbtn { color: var(--accent); }

* { box-sizing: border-box; }
[hidden] { display: none !important; }
body { background: var(--bg); color: var(--fg); font-family: var(--f-body); font-size: 15px; line-height: 1.5; }
.wrap { max-width: 1240px; margin: 0 auto; padding-block: 28px 56px;
  padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
h1, h2, h3 { font-family: var(--f-display); font-weight: 400; text-wrap: balance; margin: 0; letter-spacing: .02em; }
h1 { font-size: clamp(1.7rem, 3.4vw, 2.4rem); line-height: 1.1; }
h2 { font-size: 1.25rem; }
h3 { font-size: 1.02rem; }
p { margin: 0; }
.muted { color: var(--muted); }
.small { font-size: .85rem; }
button, input, select { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

header.top { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px 24px; margin-bottom: 22px; }
header.top .lede { max-width: 62ch; margin-top: 8px; color: var(--muted); }
.elements { display: flex; gap: 6px; }
.elements span { width: 14px; height: 14px; border-radius: 50%; display: block; }
.toolbar { display: flex; flex-wrap: wrap; gap: 8px; }
.btn { border: 1px solid var(--line); background: var(--surface); padding: 7px 13px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: .88rem; }
.btn:hover { border-color: var(--accent); }
.btn.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
.btn.ghost { background: transparent; }

.layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(320px, 400px); gap: 24px; align-items: start; }
@media (max-width: 940px) { .layout { grid-template-columns: minmax(0, 1fr); } .tablet-col { order: -1; } }

/* Section shell */
.section { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); padding: 18px; display: grid; gap: 14px; }
.editor { display: grid; gap: 18px; min-width: 0; }
.sec-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 6px 14px; }
.sec-head .tiers { display: flex; gap: 5px; }
.tier { font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; padding: 2px 7px; border-radius: 99px; border: 1px solid currentColor; }
.tier.g { color: var(--gold); } .tier.s { color: var(--silver); } .tier.b { color: var(--bronze); }

/* Party */
.mode { display: flex; flex-wrap: wrap; gap: 6px; background: var(--sunk); padding: 4px; border-radius: 9px; width: fit-content; max-width: 100%; }
.mode label { padding: 6px 12px; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: .86rem; color: var(--muted); }
.mode input { position: absolute; opacity: 0; pointer-events: none; }
.mode input:checked + span { color: var(--fg); }
.mode label:has(input:checked) { background: var(--surface); box-shadow: 0 1px 2px rgba(0,0,0,.12); color: var(--fg); }
.mode label:has(input:focus-visible) { outline: 2px solid var(--accent); }
.party { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
@media (max-width: 1100px) { .party { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 460px) { .party { grid-template-columns: minmax(0, 1fr); } }
.hero { border: 1px solid var(--line); border-radius: 9px; padding: 12px; display: grid; gap: 8px; border-top: 4px solid var(--el); background: linear-gradient(var(--el-soft), transparent 70px); }
.hero .nm { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
.hero .cls { font-size: .74rem; color: var(--muted); }
.statrow { display: grid; grid-template-columns: 3.2em minmax(0,1fr); align-items: center; gap: 8px; }
.statrow label { font-size: .74rem; font-weight: 700; letter-spacing: .08em; color: var(--muted); }
.num { width: 100%; padding: 5px 8px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); font-variant-numeric: tabular-nums; text-align: right; }
.num.bad, .item-in.bad { border-color: var(--bad); background: var(--bad-soft); }
.stored { grid-column: 2; font-size: .72rem; color: var(--muted); text-align: right; margin-top: -6px; font-variant-numeric: tabular-nums; }
.lvl .num { font-weight: 700; }

/* Djinn */
.djinn { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
@media (max-width: 760px) { .djinn { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
.el-col { display: grid; gap: 6px; align-content: start; }
.el-col header { display: flex; justify-content: space-between; align-items: center; gap: 6px; border-bottom: 2px solid var(--el); padding-bottom: 4px; }
.el-col header h3 { color: var(--el); }
.linkbtn { background: none; border: 0; padding: 2px 0; color: var(--muted); font-size: .76rem; cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
.dj { display: flex; align-items: center; gap: 8px; padding: 5px 9px; border-radius: 7px; border: 1px solid var(--line); cursor: pointer; font-weight: 500; user-select: none; }
.dj input { accent-color: var(--el); margin: 0; }
.dj:has(input:checked) { background: var(--el-soft); border-color: var(--el); }
.count { font-variant-numeric: tabular-nums; font-size: .78rem; color: var(--muted); }

/* Items */
.tabs { display: flex; flex-wrap: wrap; gap: 6px; }
.tab { border: 1px solid var(--line); background: var(--surface); padding: 6px 14px; border-radius: 99px; cursor: pointer; font-weight: 600; font-size: .88rem; display: inline-flex; align-items: center; gap: 7px; }
.tab .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--el); }
.tab[aria-selected="true"] { background: var(--el-soft); border-color: var(--el); }
.tab .badge { font-size: .72rem; color: var(--muted); font-variant-numeric: tabular-nums; }
.slots { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 8px 14px; }
.slot { display: grid; grid-template-columns: 1.6em minmax(0, 1fr) 4.2em; gap: 6px; align-items: center; }
.slot .n { font-size: .75rem; color: var(--muted); text-align: right; font-variant-numeric: tabular-nums; }
.item-in { width: 100%; padding: 5px 8px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); min-width: 0; }
.qty { padding: 5px 6px; }
.qty:disabled { opacity: .35; }
.slot .err { grid-column: 2 / 4; font-size: .74rem; color: var(--bad); margin-top: -3px; }
.psy { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
.psy .chip { font-size: .78rem; padding: 3px 9px; border-radius: 99px; border: 1px dashed var(--line); color: var(--muted); }
.psy .chip.on { border-style: solid; border-color: var(--accent); background: var(--accent-soft); color: var(--fg); font-weight: 600; }
.hint { font-size: .82rem; color: var(--muted); max-width: 70ch; }

/* Story & coins */
.events { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 8px; }
.ev { display: flex; gap: 9px; align-items: center; padding: 8px 11px; border: 1px solid var(--line); border-radius: 8px; cursor: pointer; }
.ev input { accent-color: var(--accent); margin: 0; }
.ev:has(input:checked) { border-color: var(--accent); background: var(--accent-soft); }
.coins { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
.coins .num { width: 11em; }

/* Password tablet */
.tablet-col { position: sticky; top: calc(env(safe-area-inset-top, 0px) + 16px); min-width: 0; }
@media (max-width: 940px) { .tablet-col { position: static; } }
.tablet { background: var(--tablet); color: var(--tablet-fg); border-radius: 14px; padding: 16px; display: grid; gap: 12px; box-shadow: 0 10px 30px -14px rgba(10,14,30,.6); }
.tablet h2 { color: var(--tablet-fg); font-size: 1.1rem; }
.ttabs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
.ttab { border: 1px solid #ffffff22; background: transparent; color: var(--tablet-dim); padding: 7px 4px; border-radius: 8px; cursor: pointer; font-family: var(--f-display); font-size: .95rem; display: grid; gap: 1px; justify-items: center; }
.ttab small { font-family: var(--f-body); font-size: .7rem; letter-spacing: .02em; }
.ttab[aria-selected="true"] { color: #1a1406; background: var(--tc); border-color: var(--tc); }
